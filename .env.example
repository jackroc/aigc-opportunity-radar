# Optional hosted conversation storage
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-a-server-only-service-role-key
DEVICE_SESSION_SECRET=replace-with-at-least-32-random-characters

# Optional platform-provided AI on Vercel
OPENAI_API_KEY=replace-with-a-server-only-api-key
OPENAI_MODEL=gpt-5.6
PLATFORM_AI_ENABLED=false
PLATFORM_AI_DAILY_LIMIT=10

# Optional comma-separated Responses-compatible hosts for user-supplied API keys
AI_PROVIDER_ALLOWED_HOSTS=api.openai.com

# Optional local development port
RADAR_DEV_PORT=8000
